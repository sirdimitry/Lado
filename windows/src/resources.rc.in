#include <windows.h>

#include "@SRC_DIR@/resource.h"

IDI_APP ICON "@ICON_DIR@/app.ico"
IDI_RU ICON "@ICON_DIR@/ru.ico"
IDI_EN ICON "@ICON_DIR@/en.ico"
IDI_RU_SECURE ICON "@ICON_DIR@/ru_secure.ico"
IDI_EN_SECURE ICON "@ICON_DIR@/en_secure.ico"
IDI_OTHER ICON "@ICON_DIR@/other.ico"
IDI_PAUSED ICON "@ICON_DIR@/paused.ico"

IDR_LEXICON RCDATA "@LEXICON@"

1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sirdimitry"
            VALUE "FileDescription", "Lado RU/EN keyboard layout companion"
            VALUE "FileVersion", "0.1.1.0"
            VALUE "InternalName", "Lado"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Lado.exe"
            VALUE "ProductName", "Lado for Windows"
            VALUE "ProductVersion", "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
